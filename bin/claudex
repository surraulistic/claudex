#!/usr/bin/env node
import { homedir } from 'node:os';
import { join } from 'node:path';
import { run, runAll } from '../lib/exec.js';
import { buildDigest, DEFAULTS } from '../lib/digest.js';
import { buildBrief, BRIEF_DEFAULTS } from '../lib/brief.js';
import { buildWatch, WATCH_DEFAULTS } from '../lib/watch.js';
import { buildPanes } from '../lib/sessions.js';
import { resolveTarget } from '../lib/target.js';
import { readDigest, searchEntries, readEntry, readContext, DEFAULT_INDEX } from '../lib/store.js';
import { buildIndex } from '../lib/index-build.js';
import { groupBySession } from '../lib/find.js';
import { ftsQuery } from '../lib/sql.js';
import { cutText, toIso } from '../lib/normalize.js';

const USAGE = `claudex — сводка по сессиям Claude Code (cass + Herdr)

  claudex sessions [--cwd <path>]        какие панели живы и что у них с историей
  claudex brief [--cwd <path>]           все панели разом: хвост, сигналы, история
  claudex <target>                       полный дайджест одной панели
  claudex search <target> "<запрос>"     поиск внутри одной сессии
  claudex find "<запрос>"                поиск по всем транскриптам, включая закрытые
  claudex entry <id>                     запись целиком, без обрезки
  claudex context <id>                   разговор вокруг записи
  claudex index [--full]                 пересобрать индекс из базы cass
  claudex watch <target>                 дождаться, пока панель освободится, и выйти

Target — алиас Herdr, pane_id, session_id, transcript_id, кусок заголовка или
cwd. Алиас не обязателен: безымянная панель адресуется своим pane_id из вывода
sessions, а закрытая сессия — ключом target из вывода find.

Флаги:
  --db-path <path>   индекс claudex (умолчание: $CLAUDEX_INDEX
                     или ~/.claudex/index.db)
  --limit N          записей истории (${DEFAULTS.limit}) / результатов поиска
  --chars N          символов на запись (${DEFAULTS.chars})
  --tail-lines N     строк живого хвоста (${DEFAULTS.tailLines}, brief ${BRIEF_DEFAULTS.tailLines})
  --cwd <path>       фильтр по рабочему каталогу
  --days N           find: не старше N дней
  --timeout N        watch: секунд ожидания (${Math.round(WATCH_DEFAULTS.timeoutMs / 1000)})
  --before N         context: записей до якоря (10)
  --after N          context: записей после якоря (20)
  --raw              запрос уходит в FTS5 как есть, без экранирования
  --pretty           JSON с отступами (по умолчанию компактный)

watch блокируется, пока панель занята, и завершается, когда она освободилась.
Запускать фоном: харнесс разбудит вас на выходе процесса.

Коды выхода: 0 успех · 2 цель не найдена · 3 Herdr недоступен · 4 ошибка вызова
              5 watch не дождался за отведённое время`;

function parseArgs(argv) {
  const flags = {};
  const positional = [];
  for (let i = 0; i < argv.length; i += 1) {
    const a = argv[i];
    if (a === '-h' || a === '--help') {
      flags.help = true;
    } else if (a.startsWith('--')) {
      const key = a.slice(2);
      const next = argv[i + 1];
      if (next === undefined || next.startsWith('--')) {
        flags[key] = true;
      } else {
        flags[key] = next;
        i += 1;
      }
    } else {
      positional.push(a);
    }
  }
  return { flags, positional };
}

function num(value, fallback) {
  const n = Number.parseInt(value, 10);
  return Number.isFinite(n) && n > 0 ? n : fallback;
}

function emit(value, pretty) {
  process.stdout.write((pretty ? JSON.stringify(value, null, 2) : JSON.stringify(value)) + '\n');
}

function fail(message, code) {
  process.stderr.write(message + '\n');
  process.exit(code);
}

function exitCodeFor(error) {
  return error?.code === 'agent_not_found' || error?.code === 'ambiguous_target' ? 2 : 3;
}

const { flags, positional } = parseArgs(process.argv.slice(2));

if (flags.help || positional.length === 0) {
  process.stdout.write(USAGE + '\n');
  process.exit(0);
}

const dbPath = flags['db-path'] || DEFAULT_INDEX;

const pretty = flags.pretty === true;
const raw = flags.raw === true;
const [command, ...rest] = positional;

if (command === 'index') {
  const built = buildIndex(run, dbPath, { full: flags.full === true });
  if (!built.ok) fail(built.reason, 4);
  emit(built.stats, pretty);
  process.exit(0);
}

if (command === 'watch') {
  const [target] = rest;
  if (!target) fail('Нужна цель: claudex watch <target>', 4);

  const built = buildWatch(run, dbPath, target, {
    timeoutMs: num(flags.timeout, WATCH_DEFAULTS.timeoutMs / 1000) * 1000,
    limit: num(flags.limit, DEFAULTS.limit),
    chars: num(flags.chars, DEFAULTS.chars),
    tailLines: num(flags['tail-lines'], DEFAULTS.tailLines),
  });
  if (!built.ok) fail(built.error.message, exitCodeFor(built.error));

  emit(built.watch, pretty);
  process.exit(built.timedOut ? 5 : 0);
}

if (command === 'sessions') {
  const built = buildPanes(run, dbPath, { cwd: flags.cwd || null });
  if (!built.ok) fail(`Herdr недоступен: ${built.error.message}`, 3);
  emit({ panes: built.panes }, pretty);
  process.exit(0);
}

if (command === 'brief') {
  const built = await buildBrief(run, runAll, dbPath, {
    cwd: flags.cwd || null,
    limit: num(flags.limit, BRIEF_DEFAULTS.limit),
    chars: num(flags.chars, BRIEF_DEFAULTS.chars),
    tailLines: num(flags['tail-lines'], BRIEF_DEFAULTS.tailLines),
  });
  if (!built.ok) fail(`Herdr недоступен: ${built.error.message}`, 3);
  emit(built.brief, pretty);
  process.exit(0);
}

if (command === 'find') {
  const query = rest.join(' ');
  const match = ftsQuery(query, { raw });
  if (!match) fail('Нужен запрос: claudex find "<запрос>"', 4);

  const chars = num(flags.chars, DEFAULTS.chars);
  const found = searchEntries(run, dbPath, match, {
    limit: num(flags.limit, DEFAULTS.limit),
    days: num(flags.days, null),
    snippetTokens: 24,
  });
  if (!found.ok) fail(`Поиск не удался: ${found.reason}`, 4);

  emit({ query, match, hits: found.results.length, sessions: groupBySession(found.results, chars) }, pretty);
  process.exit(0);
}

if (command === 'entry' || command === 'context') {
  const [id] = rest;
  if (!id) fail(`Нужен id записи: claudex ${command} <entry-id>`, 4);

  const got = command === 'entry'
    ? readEntry(run, dbPath, id)
    : readContext(run, dbPath, id, {
      before: num(flags.before, 10),
      after: num(flags.after, 20),
    });
  if (!got.ok) fail(got.reason, 4);

  if (command === 'entry') {
    const e = got.entry;
    emit({
      id: e.id,
      ts: toIso(e.ts),
      role: e.kind ?? null,
      target: e.session_id || e.transcript_id,
      transcript_id: e.transcript_id ?? null,
      agent: e.agent ?? null,
      project: e.project ?? null,
      cwd: e.cwd ?? null,
      branch: e.branch ?? null,
      chars: e.len ?? 0,
      text: e.text ?? '',
    }, pretty);
  } else {
    const c = got.context;
    emit({
      anchor: c.anchor,
      transcript_id: c.transcript_id,
      entries: (c.entries ?? []).map((e) => ({
        id: e.id,
        ts: toIso(e.ts),
        role: e.kind ?? null,
        anchor: e.anchor === 1,
        chars: e.len ?? 0,
        text: e.text ?? '',
      })),
    }, pretty);
  }
  process.exit(0);
}

if (command === 'search') {
  const [target, ...words] = rest;
  const match = ftsQuery(words.join(' '), { raw });
  if (!target || !match) fail('Нужны цель и запрос: claudex search <target> "<запрос>"', 4);

  const live = resolveTarget(run, target);
  if (!live.ok) fail(live.error.message, exitCodeFor(live.error));

  const resolved = readDigest(run, dbPath, live.agent.session_id, { limit: 0 });
  if (!resolved.ok) fail(`История недоступна: ${resolved.reason}`, 4);

  const chars = num(flags.chars, DEFAULTS.chars);
  const found = searchEntries(run, dbPath, match, {
    convId: resolved.transcriptId,
    limit: num(flags.limit, DEFAULTS.limit),
    snippetTokens: 24,
  });
  if (!found.ok) fail(`Поиск не удался: ${found.reason}`, 4);

  emit({
    target: live.agent.alias ?? live.agent.pane_id,
    transcript_id: resolved.transcriptId,
    query: words.join(' '),
    match,
    results: found.results.map((r) => ({
      id: r.id ?? null,
      ts: toIso(r.ts),
      role: r.kind ?? null,
      text: cutText(r.text, chars).text,
    })),
  }, pretty);
  process.exit(0);
}

const target = command === 'digest' ? rest[0] : command;
if (!target) fail('Нужна цель: claudex <target>', 4);

const built = buildDigest(run, dbPath, target, {
  limit: num(flags.limit, DEFAULTS.limit),
  chars: num(flags.chars, DEFAULTS.chars),
  tailLines: num(flags['tail-lines'], DEFAULTS.tailLines),
});

if (!built.ok) fail(built.error.message, exitCodeFor(built.error));

emit(built.digest, pretty);
